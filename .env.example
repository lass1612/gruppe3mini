# Network
IP_SENTINEL_CIDR=192.168.2.0/24
# Linux example: eth0. Leave empty to let Scapy choose.
IP_SENTINEL_INTERFACE=
# real = actual ARP scan; demo = generated hosts for development without raw-socket privileges
IP_SENTINEL_SCAN_MODE=real

# Optional Basic Auth. If both are set, browser/API requires login.
IP_SENTINEL_USER=admin
IP_SENTINEL_PASSWORD=change-me

# Optional SMTP alarm
IP_SENTINEL_SMTP_HOST=
IP_SENTINEL_SMTP_PORT=587
IP_SENTINEL_SMTP_USER=
IP_SENTINEL_SMTP_PASSWORD=
IP_SENTINEL_ALERT_FROM=
IP_SENTINEL_ALERT_TO=
IP_SENTINEL_SMTP_STARTTLS=1
